{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MongoDB Admin",
  "version": "0.2.2",
  "identifier": "com.daniel.mongodb-admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MongoDB Admin",
        "width": 800,
        "height": 600,
        "minWidth": 620,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RTMyODMwMEZGNDkyRTkKUldUcGt2UVBNQ2pqcDljcGh4OTJmc1grUVFmZXZrL3ljWTRZNUhnbS9KSXJUNGpMRmNaQlZ1eDgK",
      "endpoints": [
        "https://github.com/dmorsoleto/mongoDBAdmin/releases/latest/download/update.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}